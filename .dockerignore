# =========================================================
# Git与本地开发工具配置
# =========================================================

# Git历史和索引不是应用运行依赖。
.git/
.gitignore

# IDE与本地AI开发工具配置不应进入镜像。
.vscode/
.idea/
.codex/
.agents/


# =========================================================
# 密钥、环境变量和证书
# =========================================================

# Docker Compose会在启动容器时读取.env，
# 不能在构建阶段把真实密钥复制进镜像。
.env
.env.*

# 私钥、证书和常见凭据文件不能进入镜像层。
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json


# =========================================================
# Python缓存、虚拟环境和构建产物
# =========================================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/

.coverage
.coverage.*
htmlcov/
coverage.xml

.venv/
venv/
env/

build/
dist/
*.egg-info/


# =========================================================
# 本地运行数据
# =========================================================

# Chroma数据库通过Compose的volume在运行时挂载，
# 不应固化到镜像中。
chroma_data/
chroma_data.*/

# 原始语料可能包含版权、隐私或内部资料。
data/source/*
!data/source/.gitkeep

# 文档处理中间结果不属于运行镜像。
data/processed/

# 诊断会话通过运行时volume持久化，
# 不能把本机历史会话打包进镜像。
data/diagnostic_sessions/

# 评测数据和教学图片不参与生产API运行。
data/eval/
data/multimodal/

# 临时上传文件和日志属于运行期数据。
uploads/
tmp/
temp/
logs/
*.log


# =========================================================
# 测试、报告和教学材料
# =========================================================

# 运行镜像只保留应用代码，不携带测试套件。
tests/

# 本地报告可能包含引用正文和运行轨迹。
docs/

# 示例与本地实验材料不参与服务运行。
samples/

# 教学约束、每周任务和个人学习笔记。
要求.txt
week*.txt
day*.md
week*技术细节.md


# =========================================================
# 压缩包和操作系统临时文件
# =========================================================

*.zip
*.rar
*.7z
*.tar
*.tar.gz

.DS_Store
Thumbs.db

*.tmp
*.temp
*~
