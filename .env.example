# 生成式 LLM 配置
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_MODEL=your-llm-model-name

# Embedding 服务独立配置
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
EMBEDDING_MODEL=your-embedding-model-name

# Vision服务独立配置
#
# 即使Vision与文本LLM使用同一供应商，
# 也应显式填写这些值，避免图片被意外发送到错误服务。
VISION_API_KEY=your-vision-api-key
VISION_BASE_URL=https://your-vision-provider.example/v1
VISION_MODEL=your-vision-model-name

# ChromaDB 本地持久化配置
CHROMA_PERSIST_DIRECTORY=chroma_data
CHROMA_COLLECTION_NAME=robot_knowledge

# 文档切分与摄取配置
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
EMBEDDING_BATCH_SIZE=64

# RAG在线问答阈值
# Top-1低于该值时直接拒答，不调用LLM
#
# 0.60是robot_knowledge_v4与当前20题评测集上的
# 保守校准基线；更换语料或Embedding模型后必须重新评测。
RAG_SIMILARITY_THRESHOLD=0.60

# 单文件上限：20 MiB
MAX_DOCUMENT_SIZE_BYTES=20971520

# Vision图片输入策略
# 单图上限：5 MiB
MAX_VISION_IMAGE_SIZE_BYTES=5242880

# 任意一边最多4096像素
MAX_VISION_IMAGE_DIMENSION_PX=4096

# 解码后最多1600万像素
MAX_VISION_IMAGE_PIXELS=16000000

# Vision上游请求超时：60秒
VISION_TIMEOUT_SECONDS=60

# 本地Tesseract OCR基线策略
# 默认只识别英文状态字段和故障码
OCR_LANGUAGE=eng

# 低于70时标记为low_confidence并要求人工复核
OCR_MINIMUM_CONFIDENCE=70

# 单张图片OCR子进程最多运行10秒
OCR_TIMEOUT_SECONDS=10
