# =========================================================
# 真实环境配置与凭据
# =========================================================

# 忽略主环境配置。
.env

# 同时忽略未来可能出现的：
# .env.local、.env.production、.env.test 等文件。
.env.*

# .env.example 只包含占位值，需要提交给使用者。
!.env.example

# 私钥、证书与常见凭据文件。
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json


# =========================================================
# 本地教学说明、验收反馈与其他周计划
# =========================================================

# 要求.txt 只用于约束本地教学过程，不属于项目交付物。
/要求.txt

# 导师验收反馈属于本地过程记录，不公开提交。
/week*验收.txt

# 每周学习任务说明属于本地教学材料，不属于项目交付物。
# 使用通配规则覆盖Week 1及后续周次，避免新增一周时漏配。
/week[0-9]*.txt


# =========================================================
# Python、测试和静态检查缓存
# =========================================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
# pytest.ini 指定的项目内测试临时根目录。
.pytest_tmp/
.mypy_cache/
.ruff_cache/

# 覆盖率工具生成物。
.coverage
.coverage.*
htmlcov/
coverage.xml


# =========================================================
# Python虚拟环境与构建产物
# =========================================================

.venv/
venv/
env/

build/
dist/
*.egg-info/


# =========================================================
# 编辑器和操作系统文件
# =========================================================

.vscode/
.idea/

.DS_Store
Thumbs.db


# =========================================================
# 日志、临时目录和上传暂存文件
# =========================================================

logs/
*.log

tmp/
temp/
uploads/

*.tmp
*.temp
*~


# =========================================================
# 防止再次提交完整项目压缩包
# =========================================================

*.rar
*.zip
*.7z
*.tar
*.tar.gz


# =========================================================
# RAG原始语料、中间数据和向量数据库
# =========================================================

# 原始文档可能受版权、授权或隐私限制。
# 只允许提交空目录占位文件。
/data/source/*
!/data/source/.gitkeep

# 解析和切分后的中间结果可能包含完整原文。
/data/processed/

# ChromaDB包含向量、正文和元数据，可以重新生成。
/chroma_data/

# 本地排障时创建的Chroma备份同样包含正文和向量，
# 不能因为目录名增加了后缀就被意外提交。
/chroma_data.*/


# =========================================================
# 含原始Chunk或较长引用的本地评测产物
# =========================================================

# 默认忽略docs中的JSON报告，因为其中可能包含完整正文或评测明细。
/docs/*.json

# 以下Agent轨迹已经过脱敏，是Week 4要求提交的可审计运行样例。
!/docs/agent-trace-agent-001-failure.json
!/docs/agent-trace-agent-004.json
!/docs/agent-trace-agent-005.json

# 以下Markdown报告包含大量原文预览或完整引用，
# 后续将另外创建不含原文的公开汇总版本。
/docs/chunking-comparison.md
/docs/retrieval-baseline.md
/docs/retrieval-evaluation*.md
/docs/citation-evaluation*.md
/docs/rag-vs-bare-llm*.md

# 多轮摄取日志只在本地保留；
# 最终V4日志只包含文件名、哈希和数量，可以公开。
/docs/ingestion-log*.md
!/docs/ingestion-log-v4.md

# 后续创建的三份脱敏汇总报告允许提交。
!/docs/retrieval-evaluation-summary.md
!/docs/citation-evaluation-summary.md
!/docs/rag-vs-bare-llm-summary.md

# =========================================================
# 本地学习记录与AI开发工具配置
# =========================================================

# 这些文件用于个人学习过程，不属于公开项目交付物。
/day*.md
/week*技术细节.md

# 本地AI开发工具可能产生的项目级配置。
/.codex/
/.agents/


# =========================================================
# Week 3 含完整证据正文的评测明细
# =========================================================

# 单策略报告包含大量召回Chunk正文。
# 只公开经过脱敏汇总的策略对比报告。
/docs/retrieval-strategy-*.md
!/docs/retrieval-strategy-comparison.md

# 门控评测和Prompt对照报告包含逐题证据或模型输出。
# 最终结论已经写入公开的测试报告和工程复盘。
/docs/hybrid-gate-evaluation*.md
/docs/diagnosis-prompt-comparison*.md


# =========================================================
# Week 5 多模态评测中间产物
# =========================================================

# v2、v3等文件是多轮调参产生的中间报告。
# 公开仓库只保留不带版本后缀的最终报告，
# 以及其引用的完整脱敏轨迹和失败修正记录。
/docs/multimodal-evaluation-v*.md


# 历史JUnit报告不再提交，只保留最终完整回归结果。
/docs/pytest-results*.xml
!/docs/pytest-results-week3-final.xml
!/docs/pytest-results-week4-final.xml
