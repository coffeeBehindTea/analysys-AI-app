# =========================================================
# 真实环境配置与凭据
# =========================================================

# 忽略主环境配置。
.env

# 同时忽略未来可能出现的：
# .env.local、.env.production、.env.test 等文件。
.env.*

# .env.example 只包含占位值，需要提交给使用者。
!.env.example

# 私钥、证书与常见凭据文件。
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json


# =========================================================
# 本地教学说明、验收反馈与其他周计划
# =========================================================

# 要求.txt 只用于约束本地教学过程，不属于项目交付物。
/要求.txt

# 导师验收反馈属于本地过程记录，不公开提交。
/week*验收.txt

# Week 1/2 学习任务说明属于本地教学材料，不属于项目交付物。
/week1.txt
/week2.txt

# Week 3 应在独立项目中管理，不放入 Week 2 仓库。
/week3.txt


# =========================================================
# Python、测试和静态检查缓存
# =========================================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

# 覆盖率工具生成物。
.coverage
.coverage.*
htmlcov/
coverage.xml


# =========================================================
# Python虚拟环境与构建产物
# =========================================================

.venv/
venv/
env/

build/
dist/
*.egg-info/


# =========================================================
# 编辑器和操作系统文件
# =========================================================

.vscode/
.idea/

.DS_Store
Thumbs.db


# =========================================================
# 日志、临时目录和上传暂存文件
# =========================================================

logs/
*.log

tmp/
temp/
uploads/

*.tmp
*.temp
*~


# =========================================================
# 防止再次提交完整项目压缩包
# =========================================================

*.rar
*.zip
*.7z
*.tar
*.tar.gz


# =========================================================
# RAG原始语料、中间数据和向量数据库
# =========================================================

# 原始文档可能受版权、授权或隐私限制。
# 只允许提交空目录占位文件。
/data/source/*
!/data/source/.gitkeep

# 解析和切分后的中间结果可能包含完整原文。
/data/processed/

# ChromaDB包含向量、正文和元数据，可以重新生成。
/chroma_data/


# =========================================================
# 含原始Chunk或较长引用的本地评测产物
# =========================================================

# 当前docs下的JSON报告包含完整content或excerpt，
# 因此全部作为本地生成物，不公开提交。
/docs/*.json

# 以下Markdown报告包含大量原文预览或完整引用，
# 后续将另外创建不含原文的公开汇总版本。
/docs/chunking-comparison.md
/docs/retrieval-baseline.md
/docs/retrieval-evaluation*.md
/docs/citation-evaluation*.md
/docs/rag-vs-bare-llm*.md

# 多轮摄取日志只在本地保留；
# 最终V4日志只包含文件名、哈希和数量，可以公开。
/docs/ingestion-log*.md
!/docs/ingestion-log-v4.md

# 后续创建的三份脱敏汇总报告允许提交。
!/docs/retrieval-evaluation-summary.md
!/docs/citation-evaluation-summary.md
!/docs/rag-vs-bare-llm-summary.md
